{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "python3",
            "args": ["${CLAUDE_PROJECT_DIR}/.claude/hooks/security_reminder_hook.py"],
            "statusMessage": "Security anti-pattern check",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
